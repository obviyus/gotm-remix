{
	"name": "gotm-remix",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "bunx react-router build",
		"dev": "./portless.sh",
		"dev:direct": "NODE_ENV=development bun run dev-server.ts",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"schema:sync": "bun run scripts/sync-turso-schema.ts",
		"start": "bun run server.ts",
		"test": "bun test --parallel",
		"typecheck": "bunx react-router typegen && bunx tsc --noEmit -p tsconfig.json",
		"knip": "knip"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource/inter": "^5.3.0",
		"@hello-pangea/dnd": "^18.0.1",
		"@libsql/client": "^0.18.0",
		"@react-router/node": "^8.3.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0",
		"isbot": "^5.2.2",
		"lucide-react": "^1.41.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.1",
		"satori": "^0.33.4",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@babel/preset-typescript": "^7.29.7",
		"@react-router/dev": "^8.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.7",
		"babel-plugin-react-compiler": "^1.0.0",
		"knip": "^6.34.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"portless": "^0.15.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-babel": "^1.7.3"
	},
	"engines": {
		"node": ">=22.22.0"
	}
}
